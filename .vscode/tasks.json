{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "client",
      "type": "shell",
      "command": "npm run dev -- --host",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "server",
      "type": "shell",
      "command": "nodemon",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "start-all",
      "dependsOn": [
        "client",
        "server"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "repo-commit",
      "type": "shell",
      "command": "git checkout --orphan TEMP_BRANCH && git add -A && git commit -m \"PicShare Official Repository\" && git branch -D main && git branch -m main && git push -f origin main",
      "presentation": {
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
